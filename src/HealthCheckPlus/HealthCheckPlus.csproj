<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<NeutralLanguage>en</NeutralLanguage>
		<AssemblyName>HealthCheckPlus</AssemblyName>
		<RootNamespace>HealthCheckPlus</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>4.0.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>Fernando Cerqueira</Authors>
		<Description>HealthCheck with individual policies based on healthy/degraded/unhealthy status and optimized Report Publisher.</Description>
		<PackageReleaseNotes>https://github.com/FRACerqueira/HealthCheckPlus/releases</PackageReleaseNotes>
		<PackageTags>HealthCheck;healthchecks;aspnetcore;monitoring;observability;csharp</PackageTags>
		<RepositoryUrl>https://github.com/FRACerqueira/HealthCheckPlus</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageId>HealthCheckPlus</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<Copyright>© 2023 - Fernando Cerqueira</Copyright>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>HealthCheckPlusTests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<Content Include="README.txt">
			<Pack>true</Pack>
			<PackagePath>README.txt</PackagePath>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\icon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<!--
		Plain ProjectReference, no special metadata: the previous CopyProjectReferencesToPackage
		target embedded HealthCheckPlus.Abstractions.dll directly into this package's lib/ folder
		while emitting an empty <dependencies> group in the nuspec - a consumer who also installed
		the separately-documented HealthCheckPlus.Abstractions package (as the README instructs for
		projects that only need the abstractions) ended up with two independent copies of the same
		types, with no NuGet version constraint tying them together. Letting `dotnet pack` apply
		its default behavior for a ProjectReference to another packable project instead declares a
		real `<dependency>` on HealthCheckPlus.Abstractions at this project's own Version - the two
		packages are versioned together in this repo, so that dependency is always satisfied by the
		matching release.
	-->
	<ItemGroup>
		<ProjectReference Include="..\HealthCheckPlus.Abstractions\HealthCheckPlus.Abstractions.csproj" />
	</ItemGroup>
</Project>
